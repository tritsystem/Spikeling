# --- Godot 4 ---
# editor cache, regenerated on open (inline comments are NOT allowed on pattern lines)
.godot/

# ── PRIVATE -- never publish (this repo is public) ──
# gitignore has NO inline comments -- a trailing "# note" becomes part of the
# pattern and silently matches nothing. Comments must be on their own line.

# private research memory: findings, retired/negative results, honest ledger
vault/
# personal: every command ever typed to the bot
voice_interaction_log.csv
# personal: logged agent-pipeline routing decisions (task text + scores)
task_decisions.jsonl
# personal: accumulated specialist promotion track record (grows with real usage)
specialist_history.json
# TOTP enrolment QR (encodes the admin secret)
admin_totp_qr*
# generated write-and-run scratch scripts
experiments/
*.log
clip_*.gif
screenshot_*.png
res_*.txt
test_result*.txt

# node deps for the react-render/screenshot pipeline (package.json declares them)
node_modules/
*.log.err
acoustic_baseline*.json

# SPIKEMESH (ai-apps/): huge/generated/personal, kept out for the same reasons as above
# offline Wiktionary dump + kiwix tool binaries -- 8.6GB, nowhere near git's limits
ai-apps/kiwix/
# regeneratable build artifact (embeddings index), not source
ai-apps/vault_semantic_index/
# generated output, regeneratable from playbook_generator.py
ai-apps/generated_playbooks/
# generated backup snapshots
ai-apps/backups/
# personal: real project-manager notes (same reasoning as vault/ above)
ai-apps/pm_data/
# personal: real dismantling/diagnostic photos of physical hardware
electronics_captures/
