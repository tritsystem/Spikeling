# animal_detector_gate.spk
# =====================================================================
# AUTO-GENERATED by animal_gate_spk_builder.py from animal_acoustic_config.py
# -- do not hand-edit the neuron/action lines below; edit the config and
# re-run the builder instead. See that config module's docstring for the
# real-data discipline (every frequency here is cited, not invented) and
# animal_species_classifier.py for how acoustic + environmental channels
# are composed (NOT via `connect` -- see the builder's own module
# docstring for the real architectural reason why).
#
# Config-driven animal-call discrimination prototype (generalized from an
# original UK-bat-specific version). Populated classes and their citations:
#   CommonPip (species-level): Common Pipistrelle peak call frequency ~45kHz (established UK bat bioacoustics)
#   SopranoPip (species-level): Soprano Pipistrelle peak call frequency ~55kHz -- classic confusable pair with Common Pip (separation is mostly a frequency-threshold problem around ~47-48kHz)
#   BigBatCluster (genus/cluster-level): Nyctalus/Eptesicus cluster ~20-27kHz, louder/longer calls -- acoustically distinct, should be the easiest cluster to separate
#   Myotis (genus/cluster-level): Myotis genus: steep FM sweep ~80kHz down to ~30-40kHz, short duration (~3-5ms) -- genuinely overlapping acoustic parameter space between species; a documented open problem in bat bioacoustics, not a modeling shortfall. Detectable as a genus/cluster, not reliably separable to species from call shape alone.
#
# TESTED ONLY against synthetic tones/chirps (see
# test_animal_gate_synthetic.py) -- never against a real recording of any
# of the above. This is a capability-bar test of the Resonator primitive,
# not a validated classifier for any real animal.

# ---- Acoustic channels (Resonator neurons, config-driven) ----
neuron CommonPip type=Resonator freq=45000.0 damping=0.05
neuron SopranoPip type=Resonator freq=55000.0 damping=0.05
neuron BigBatCluster type=Resonator freq=23500.0 damping=0.05
neuron Myotis_LowBand type=Resonator freq=40000.0 damping=0.15
neuron Myotis_MidBand type=Resonator freq=60000.0 damping=0.15
neuron Myotis_HighBand type=Resonator freq=75000.0 damping=0.15

# ---- Environmental-plausibility gate channels (plain LIF, rate-coded) ----
# One shared neuron per EnvGateRule (not per-class) -- driven externally by
# animal_species_classifier.set_environment() at a rate that reliably
# crosses threshold when the rule's condition is currently true.
neuron GateActiveSeason threshold=40 leak=5 type=LIF
neuron GateMinSurveyTemp threshold=40 leak=5 type=LIF
neuron GateHeavyRainSuppress threshold=40 leak=5 type=LIF

# ---- Regional/geolocation prior channels (STUB -- see config's
# REGION_PRIOR_STUB docstring; every class gets one real, wired input
# channel here even though the driving value is currently neutral) ----
neuron RegionPrior_CommonPip threshold=40 leak=5 type=LIF
neuron RegionPrior_SopranoPip threshold=40 leak=5 type=LIF
neuron RegionPrior_BigBatCluster threshold=40 leak=5 type=LIF
neuron RegionPrior_Myotis threshold=40 leak=5 type=LIF

# ---- Actions ----
action CommonPip -> [DETECT_COMMONPIP]
action SopranoPip -> [DETECT_SOPRANOPIP]
action BigBatCluster -> [DETECT_BIGBATCLUSTER]
action Myotis_LowBand -> [DETECT_MYOTIS_LOWBAND]
action Myotis_MidBand -> [DETECT_MYOTIS_MIDBAND]
action Myotis_HighBand -> [DETECT_MYOTIS_HIGHBAND]
action GateActiveSeason -> [ENV_GATE_ACTIVESEASON]
action GateMinSurveyTemp -> [ENV_GATE_MINSURVEYTEMP]
action GateHeavyRainSuppress -> [ENV_GATE_HEAVYRAINSUPPRESS]
action RegionPrior_CommonPip -> [ENV_REGION_COMMONPIP]
action RegionPrior_SopranoPip -> [ENV_REGION_SOPRANOPIP]
action RegionPrior_BigBatCluster -> [ENV_REGION_BIGBATCLUSTER]
action RegionPrior_Myotis -> [ENV_REGION_MYOTIS]

refractory=1ms
